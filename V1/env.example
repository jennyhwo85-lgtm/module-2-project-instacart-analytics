# ============================================================
# Original DuckDB -> BigQuery pipeline
# ============================================================

GCP_PROJECT_ID=your-gcp-project-id
GCP_RAW_DATASET=instacart_raw
GCP_ANALYTICS_DATASET=instacart_analytics
GCP_LOCATION=your-gcp-location

DUCKDB_PATH=Warehouse/instacart.duckdb
GCS_PARQUET_BUCKET=your-gcs-parquet-bucket-name

# Absolute local path; never commit the actual JSON key file
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your-service-account-key.json


# ============================================================
# Supabase HTTPS REST API
# ============================================================

SUPABASE_URL=https://your-project-reference.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key


# ============================================================
# Supabase PostgreSQL -> Meltano tap-postgres
# Use the Session Pooler connection details from Supabase
# ============================================================

TAP_POSTGRES_HOST=your-supabase-session-pooler-host
TAP_POSTGRES_PORT=5432
TAP_POSTGRES_DATABASE=postgres
TAP_POSTGRES_USER=postgres.your-project-reference
TAP_POSTGRES_PASSWORD=your-supabase-database-password
TAP_POSTGRES_FILTER_SCHEMAS='["public"]'
TAP_POSTGRES_SSL_ENABLE=true
TAP_POSTGRES_SSL_MODE=require

GCP_SUPABASE_DATASET=your-supabase-raw-dataset
GCP_SUPABASE_ANALYTICS_DATASET=your-supabase-analytics-dataset

SUPABASE_SECRET_KEY=paste-the-generated-key-here

SUPABASE_API_LOAD_URL=https://new-project-reference.supabase.co
SUPABASE_API_LOAD_SECRET_KEY=paste-new-project-secret-key-here